{
  "name": "liar-game",
  "version": "0.9.2",
  "private": true,
  "description": "LAN 라이어 게임 - Electron(자동 발견) / 웹(서버 1대) 두 가지로 실행",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "web": "node web/server.js",
    "test": "node test/run-all.js",
    "play": "node test/play-test.js",
    "restart": "node test/restart-test.js",
    "dist": "electron-builder --win --publish never",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "com.windowhyun.liar",
    "productName": "Slack",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "logger.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "liar-game-${version}-win-x64.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WindowHyun",
        "repo": "liar",
        "releaseType": "release"
      }
    ]
  }
}
